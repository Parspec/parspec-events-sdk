[
  {
    "name": "clean subscribe clears both versions first",
    "args": {
      "eventType": "tandemOrder.publishToErp",
      "version": 1,
      "webhookUrl": "https://erp.example/webhook/orders"
    },
    "exchange": [
      {
        "request": {
          "method": "DELETE",
          "path": "integrations/events/unsubscribe",
          "body": {
            "event_type": "tandemOrder.publishToErp",
            "event_version": 1
          }
        },
        "response": {
          "status": 200,
          "body": {}
        }
      },
      {
        "request": {
          "method": "DELETE",
          "path": "integrations/events/unsubscribe",
          "body": {
            "event_type": "tandemOrder.publishToErp",
            "event_version": 2
          }
        },
        "response": {
          "status": 404,
          "body": {}
        }
      },
      {
        "request": {
          "method": "PUT",
          "path": "integrations/events/subscribe",
          "body": {
            "event_type": "tandemOrder.publishToErp",
            "event_version": 1,
            "webhook_url": "https://erp.example/webhook/orders"
          }
        },
        "response": {
          "status": 200,
          "body": {
            "publicKey": "-----BEGIN PUBLIC KEY-----\nAAA\n-----END PUBLIC KEY-----\n"
          }
        }
      }
    ],
    "expect": {
      "publicKey": "-----BEGIN PUBLIC KEY-----\nAAA\n-----END PUBLIC KEY-----\n",
      "replaced": 0
    }
  },
