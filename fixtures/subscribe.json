[
  {
    "name": "clean subscribe clears both versions first",
    "args": { "eventType": "tandemOrder.publishToErp", "version": 1, "webhookUrl": "https://erp.example/webhook/orders" },
    "exchange": [
      { "request": { "method": "DELETE", "path": "integrations/events/unsubscribe", "body": { "event_type": "tandemOrder.publishToErp", "event_version": 1 } }, "response": { "status": 200, "body": {} } },
      { "request": { "method": "DELETE", "path": "integrations/events/unsubscribe", "body": { "event_type": "tandemOrder.publishToErp", "event_version": 2 } }, "response": { "status": 404, "body": {} } },
      { "request": { "method": "PUT", "path": "integrations/events/subscribe", "body": { "event_type": "tandemOrder.publishToErp", "event_version": 1, "webhook_url": "https://erp.example/webhook/orders" } }, "response": { "status": 200, "body": { "publicKey": "-----BEGIN PUBLIC KEY-----\nAAA\n-----END PUBLIC KEY-----\n" } } }
    ],
    "expect": { "publicKey": "-----BEGIN PUBLIC KEY-----\nAAA\n-----END PUBLIC KEY-----\n", "replaced": 0 }
  },
  {
    "name": "a second subscription on the org is cleared and the subscribe retried",
    "args": { "eventType": "quote.publishToOrderSystem", "version": 2, "webhookUrl": "https://erp.example/webhook/quotes" },
    "exchange": [
      { "request": { "method": "DELETE", "path": "integrations/events/unsubscribe", "body": { "event_type": "quote.publishToOrderSystem", "event_version": 1 } }, "response": { "status": 404, "body": {} } },
      { "request": { "method": "DELETE", "path": "integrations/events/unsubscribe", "body": { "event_type": "quote.publishToOrderSystem", "event_version": 2 } }, "response": { "status": 200, "body": {} } },
      { "request": { "method": "PUT", "path": "integrations/events/subscribe", "body": { "event_type": "quote.publishToOrderSystem", "event_version": 2, "webhook_url": "https://erp.example/webhook/quotes" } }, "response": { "status": 400, "body": { "error": "an active subscription already exists for event type quote.publishToOrderSystem and version 2" } } },
      { "request": { "method": "DELETE", "path": "integrations/events/unsubscribe", "body": { "event_type": "quote.publishToOrderSystem", "event_version": 2 } }, "response": { "status": 200, "body": {} } },
      { "request": { "method": "PUT", "path": "integrations/events/subscribe", "body": { "event_type": "quote.publishToOrderSystem", "event_version": 2, "webhook_url": "https://erp.example/webhook/quotes" } }, "response": { "status": 200, "body": { "publicKey": "KEY2" } } }
    ],
    "expect": { "publicKey": "KEY2", "replaced": 1 }
  },
  {
    "name": "a rejected subscribe raises with the status",
    "args": { "eventType": "inventory.fetchPrice", "version": 2, "webhookUrl": "https://erp.example/webhook/price" },
    "exchange": [
      { "request": { "method": "DELETE", "path": "integrations/events/unsubscribe", "body": { "event_type": "inventory.fetchPrice", "event_version": 1 } }, "response": { "status": 401, "body": {} } },
      { "request": { "method": "DELETE", "path": "integrations/events/unsubscribe", "body": { "event_type": "inventory.fetchPrice", "event_version": 2 } }, "response": { "status": 401, "body": {} } },
      { "request": { "method": "PUT", "path": "integrations/events/subscribe", "body": { "event_type": "inventory.fetchPrice", "event_version": 2, "webhook_url": "https://erp.example/webhook/price" } }, "response": { "status": 401, "body": { "error": "invalid api key" } } }
    ],
    "expect": { "error": 401 }
  }
]
