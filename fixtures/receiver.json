[
  {
    "name": "routes to the handler whose key verifies",
    "keys": {
      "tandemOrder.publishToErp": "signer.pem",
      "inventory.fetchPrice": "other.pem"
    },
    "handlers": {
      "tandemOrder.publishToErp": [
        {
          "return": {
            "orderId": "SO-1"
          }
        }
      ],
      "inventory.fetchPrice": [
        {
          "return": {
            "unitPrice": "12.3400"
          }
        }
      ]
    },
    "deliveries": [
      {
        "body": "{\"eventTransactionID\":\"d3f616c9-5a17-49c8-9530-0c73896fd260\",\"callback_url\":\"integrations/events/callback\",\"data\":{\"sku\":\"DEMO-100\"}}",
        "signature": "",
        "status": 200
      }
    ],
    "expect": {
      "calls": [
        {
          "eventType": "inventory.fetchPrice",
          "transactionId": "d3f616c9-5a17-49c8-9530-0c73896fd260"
        }
      ],
      "callbacks": [
        {
          "EventTransactionID": "d3f616c9-5a17-49c8-9530-0c73896fd260",
          "EventStatus": "success",
          "unitPrice": "12.3400"
        }
      ],
      "done": [
        "d3f616c9-5a17-49c8-9530-0c73896fd260"
      ],
      "processing": []
    }
  },
