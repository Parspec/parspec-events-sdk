  {
    "name": "a handler that throws sends an error callback and releases the claim, so a redelivery retries",
    "keys": {
      "tandemOrder.publishToErp": "signer.pem",
      "inventory.fetchPrice": "other.pem"
    },
    "handlers": {
      "tandemOrder.publishToErp": [
        {
          "throw": "ERP offline"
        },
        {
          "return": {
            "orderId": "SO-2"
          }
        }
      ]
    },
    "deliveries": [
      {
        "body": "{\"eventTransactionID\":\"ee3d4e94-1bc1-4cd3-9ae6-e05025fdee2c\",\"callback_url\":\"integrations/events/callback\",\"data\":{\"po\":1}}",
        "signature": "",
        "status": 200
      },
      {
        "body": "{\"eventTransactionID\":\"ee3d4e94-1bc1-4cd3-9ae6-e05025fdee2c\",\"callback_url\":\"integrations/events/callback\",\"data\":{\"po\":1}}",
        "signature": "",
        "status": 200
      }
    ],
    "expect": {
      "calls": [
        {
          "eventType": "tandemOrder.publishToErp",
          "transactionId": "ee3d4e94-1bc1-4cd3-9ae6-e05025fdee2c"
        },
        {
          "eventType": "tandemOrder.publishToErp",
          "transactionId": "ee3d4e94-1bc1-4cd3-9ae6-e05025fdee2c"
        }
      ],
      "callbacks": [
        {
          "EventTransactionID": "ee3d4e94-1bc1-4cd3-9ae6-e05025fdee2c",
          "EventStatus": "error",
          "errorMessage": "ERP offline"
        },
        {
          "EventTransactionID": "ee3d4e94-1bc1-4cd3-9ae6-e05025fdee2c",
          "EventStatus": "success",
          "orderId": "SO-2"
        }
      ],
      "done": [
        "ee3d4e94-1bc1-4cd3-9ae6-e05025fdee2c"
      ],
      "processing": []
    }
  },
